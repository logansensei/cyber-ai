# CyberSentinel AI Configuration
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# API Base URL (for EC2 deployment)
API_BASE_URL=http://your-ec2-public-ip:3000

# AI Provider API Keys
# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# Security Configuration
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration (EC2 specific)
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.json,.yaml,.yml,.har
UPLOAD_DIR=/tmp/uploads/

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/cybersentinel.log

# Database Configuration (if using database)
# DATABASE_URL=postgresql://username:password@localhost:5432/cybersentinel
# REDIS_URL=redis://localhost:6379

# External API Configuration
# PROXY_URL=http://localhost:8080
# TIMEOUT_MS=30000

# Feature Flags
ENABLE_AI=true
ENABLE_RATE_LIMITING=true
ENABLE_LOGGING=true
ENABLE_METRICS=true

# Development Configuration
DEBUG=false
VERBOSE_LOGGING=false

# EC2 Specific Configuration
EC2_INSTANCE_ID=your-instance-id
EC2_REGION=us-east-1
