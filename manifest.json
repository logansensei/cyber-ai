  "screenshots": [
    {
      "src": "/screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "CyberSentinel AI Dashboard"
    },
    {
      "src": "/screenshots/mobile-1.png",
      "sizes": "375x667",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile Security Testing Interface"
    }
  ],
  "shortcuts": [
    {
      "name": "Start New Scan",
      "short_name": "New Scan",
      "description": "Start a new API security scan",
      "url": "/?action=scan",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "View Results",
      "short_name": "Results",
      "description": "View latest scan results",
      "url": "/?action=results",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "capture_links": "new-client",
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/json": [".json"],
        "application/yaml": [".yaml", ".yml"],
        "text/plain": [".har"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+cybersentinel",
      "url": "/?protocol=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["application/json", "application/yaml", "text/plain"]
        }
      ]
    }
  }
}
