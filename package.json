{
  "name": "cybersentinel-ai",
  "version": "1.0.0",
  "description": "Advanced AI-Driven API Security Testing Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs cybersentinel-ai",
    "pm2:monit": "pm2 monit",
    "build": "echo 'No build step required for production'",
    "test": "echo \"No tests specified\" && exit 0",
    "deploy:ec2": "pm2 deploy production",
    "setup:ec2": "chmod +x deployment/aws-ec2-setup.sh && ./deployment/aws-ec2-setup.sh"
  },
  "keywords": [
    "security",
    "api",
    "testing",
    "ai",
    "cybersecurity",
    "penetration-testing",
    "owasp",
    "vulnerability-scanning"
  ],
  "author": "CyberSentinel AI Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "yaml": "^2.3.4",
    "axios": "^1.6.0",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^2.0.1",
    "openai": "^4.20.1",
    "@google/generative-ai": "^0.2.1",
    "swagger-parser": "^10.0.3",
    "js-yaml": "^4.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cybersentinel-ai/cybersentinel-ai.git"
  },
  "bugs": {
    "url": "https://github.com/cybersentinel-ai/cybersentinel-ai/issues"
  },
  "homepage": "https://github.com/cybersentinel-ai/cybersentinel-ai#readme"
}
